{
  "name": "quantum-codex-desktop",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "description": "macOS control plane for Quantum-Codex-OSS-MLX-Server",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "tauri": "tauri",
    "app:dev": "CARGO_TARGET_DIR=\"$PWD/../../build/desktop/tauri\" tauri dev",
    "app:build": "CARGO_TARGET_DIR=\"$PWD/../../build/desktop/tauri\" tauri build",
    "sync-resources": "node scripts/sync-server-resources.mjs",
    "test": "vitest run"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^25.0.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.7"
  }
}
