{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex GPT-OSS Server",
  "version": "1.0.0",
  "identifier": "com.exalandru.qcs",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5274",
    "beforeDevCommand": "npm run sync-resources && npm run dev",
    "beforeBuildCommand": "npm run sync-resources && npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Quantum Codex GPT-OSS Server",
        "label": "main",
        "width": 1120,
        "height": 780,
        "minWidth": 860,
        "minHeight": 580,
        "titleBarStyle": "Transparent"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "minimumSystemVersion": "14.0",
      "signingIdentity": "-"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": [
      "../../../build/desktop/staging/binaries/uv"
    ],
    "resources": {
      "../../../build/desktop/staging/resources/server/": "server/",
      "../../../build/desktop/staging/resources/server/.python-version": "server/.python-version"
    }
  },
  "mainBinaryName": "Codex GPT-OSS Server"
}
